{
  "expo": {
    "name": "tracker-app",
    "slug": "tracker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.jooecoodes.trackerapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5bca11c1-6d51-4fb3-8ded-48ec6e67c5d0"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Allow tracker-app to share your location in the background."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Northpoint to take work photos for HR.",
          "photosPermission": "Allow Northpoint to select work photos for HR.",
          "microphonePermission": false
        }
      ],
      "expo-background-task",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/northpoint-logo.png",
          "largeIcon": "./assets/northpoint-logo.png",
          "color": "#285587",
          "defaultChannel": "photo-status-silent",
          "enableRemoteNotifications": false
        }
      ]
    ]
  }
}
